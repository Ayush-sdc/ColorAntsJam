MemoryCaptures/
Recordings/

# Asset meta-files can cause conflicts with redone GUIDs, but should be included:
# !*.meta

# Uncomment this line to ignore accidental leak of sensitivity credentials:
# /Assets/Plugins/Editor/MySecretFolder*

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.app

# Crashlytics generated file
crashlytics-build.properties

# Visual Studio / Rider / VS Code generated files
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler
*.profiler

# OS generated
.DS_Store
Thumbs.db

# Scratch, logs, and backups
*.bak
*.bak.meta
*_BACKUP*
*.log
*.zip
*.xlsx
scratch_*
test_parity_output.txt
level6_queues_analysis.txt
__pycache__/
